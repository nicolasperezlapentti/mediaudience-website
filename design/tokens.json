{
  "$meta": {
    "name": "Mediaudience — Signal",
    "version": "1.0.1",
    "source": "Manual de Marca Mediaudience Signal",
    "theme": "dark-only",
    "notes": "Sistema dark-first. No existe tema claro definido; los valores *Inverse / onLight cubren piezas impresas y superficies claras puntuales.",
    "changelog": [
      "1.0.1 — textPlaceholder (#7782A3) separado de textTertiary: el original falla WCAG AA (2.99:1) y no es usable en placeholders ni ticks de eje. textTertiary/textDisabled se conservan para texto deshabilitado, exento de contraste. chart.axis actualizado al valor accesible. Añadidos sizeSm/sizeMd en display, h1 y kpi."
    ]
  },
  "color": {
    "primary": "#2AD5E5",
    "primaryHover": "#2DE6F7",
    "primaryActive": "#00BBCB",
    "primaryDisabled": "#1A4B52",
    "primarySubtle": "rgba(42,213,229,0.10)",
    "primaryBorder": "rgba(42,213,229,0.35)",
    "onPrimary": "#04121A",
    "secondary": "#68D7A1",
    "secondaryHover": "#7FE0B0",
    "onSecondary": "#04121A",
    "accent": "#2AD5E5",
    "background": "#0A0E17",
    "backgroundAlt": "#06090F",
    "surface": "#121828",
    "surfaceRaised": "#1A2135",
    "surfaceHover": "#1A2135",
    "surfaceDisabled": "#121828",
    "text": "#E9EDF6",
    "textMuted": "#8A93A9",
    "textTertiary": "#565E76",
    "textPlaceholder": "#7782A3",
    "textDisabled": "#565E76",
    "textInverse": "#0A0E17",
    "textOnLight": "#0A0E17",
    "textOnLightMuted": "#8A93A9",
    "border": "rgba(255,255,255,0.09)",
    "borderSubtle": "rgba(255,255,255,0.05)",
    "borderStrong": "rgba(255,255,255,0.16)",
    "borderFocus": "#2AD5E5",
    "success": "#68D7A1",
    "warning": "#EDBC4A",
    "error": "#E4665B",
    "successSubtle": "rgba(104,215,161,0.10)",
    "warningSubtle": "rgba(237,188,74,0.10)",
    "errorSubtle": "rgba(228,102,91,0.10)",
    "white": "#FFFFFF",
    "chart": {
      "series1": "#2AD5E5",
      "series2": "#68D7A1",
      "inert": "#1A2135",
      "axis": "#7782A3",
      "grid": "rgba(255,255,255,0.05)"
    },
    "gradient": {
      "heroBloom": "radial-gradient(60% 80% at 85% 0%, rgba(42,213,229,0.12) 0%, rgba(42,213,229,0) 70%)",
      "scanlines": "repeating-linear-gradient(90deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 80px)",
      "dataGrid": "linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px)"
    }
  },
  "typography": {
    "fontFamilyPrimary": "Space Grotesk",
    "fontFamilySecondary": "IBM Plex Sans",
    "fontFamilyMono": "JetBrains Mono",
    "fontStackPrimary": "'Space Grotesk', system-ui, sans-serif",
    "fontStackSecondary": "'IBM Plex Sans', system-ui, sans-serif",
    "fontStackMono": "'JetBrains Mono', ui-monospace, monospace",
    "fontSource": "Google Fonts (SIL Open Font License 1.1, libres, sin costo). Actual: @import de fonts.googleapis.com. Para producción SSR/SSG: self-host WOFF2 vía fontsource (@fontsource/space-grotesk, @fontsource/ibm-plex-sans, @fontsource/jetbrains-mono) y servir subset latin con font-display: swap.",
    "fontSourceSelfHosted": false,
    "fontLicense": "SIL Open Font License 1.1",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "primaryAvailable": [
        400,
        500,
        600,
        700
      ],
      "secondaryAvailable": [
        400,
        500,
        600
      ],
      "monoAvailable": [
        400,
        500,
        700
      ]
    },
    "scale": {
      "display": {
        "size": "4rem",
        "lineHeight": 1.02,
        "weight": 600,
        "letterSpacing": "-0.03em",
        "family": "primary",
        "sizeMd": "3rem",
        "sizeSm": "2.25rem"
      },
      "h1": {
        "size": "2.375rem",
        "lineHeight": 1.1,
        "weight": 600,
        "letterSpacing": "-0.02em",
        "family": "primary",
        "sizeSm": "1.875rem"
      },
      "h2": {
        "size": "1.5rem",
        "lineHeight": 1.25,
        "weight": 500,
        "letterSpacing": "-0.02em",
        "family": "primary"
      },
      "h3": {
        "size": "1.25rem",
        "lineHeight": 1.35,
        "weight": 600,
        "letterSpacing": "-0.01em",
        "family": "primary"
      },
      "body": {
        "size": "1rem",
        "lineHeight": 1.5,
        "weight": 400,
        "letterSpacing": "0em",
        "family": "secondary"
      },
      "bodyLarge": {
        "size": "1.125rem",
        "lineHeight": 1.6,
        "weight": 400,
        "letterSpacing": "0em",
        "family": "secondary"
      },
      "small": {
        "size": "0.875rem",
        "lineHeight": 1.55,
        "weight": 400,
        "letterSpacing": "0em",
        "family": "secondary"
      },
      "caption": {
        "size": "0.75rem",
        "lineHeight": 1.4,
        "weight": 400,
        "letterSpacing": "0.14em",
        "family": "mono",
        "textTransform": "uppercase"
      },
      "mono": {
        "size": "0.8125rem",
        "lineHeight": 1.4,
        "weight": 400,
        "letterSpacing": "0.02em",
        "family": "mono"
      },
      "eyebrow": {
        "size": "0.75rem",
        "lineHeight": 1.2,
        "weight": 400,
        "letterSpacing": "0.24em",
        "family": "mono",
        "textTransform": "uppercase"
      },
      "label": {
        "size": "0.5625rem",
        "lineHeight": 1.2,
        "weight": 400,
        "letterSpacing": "0.14em",
        "family": "mono",
        "textTransform": "uppercase"
      },
      "kpi": {
        "size": "2.5rem",
        "lineHeight": 1,
        "weight": 600,
        "letterSpacing": "-0.02em",
        "family": "primary",
        "sizeSm": "2rem"
      },
      "kpiSmall": {
        "size": "1.625rem",
        "lineHeight": 1,
        "weight": 600,
        "letterSpacing": "-0.02em",
        "family": "primary"
      }
    },
    "minSize": {
      "mono": "0.5625rem",
      "body": "0.75rem"
    }
  },
  "spacing": {
    "base": "4px",
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "2xl": "2.25rem",
    "3xl": "4.5rem",
    "sectionY": "4.5rem",
    "gridGap": "0.75rem",
    "sectionGap": "1rem",
    "contentPadding": "1.5rem"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "12px",
    "full": "9999px",
    "default": "6px",
    "appFrame": "12px"
  },
  "shadow": {
    "sm": "none",
    "md": "none",
    "lg": "0 40px 80px -40px rgba(0,0,0,1)",
    "focusRing": "0 0 0 1px #2AD5E5",
    "notes": "El sistema no usa sombras dentro de la UI; la separación es por hairline de 1px. shadow.lg se reserva para un frame/mockup flotante."
  },
  "layout": {
    "maxWidth": "1200px",
    "maxWidthWide": "1440px",
    "maxWidthProse": "620px",
    "gutter": "1.5rem",
    "sidebarWidth": "200px",
    "topbarHeight": "58px",
    "breakpoints": {
      "sm": "640px",
      "md": "900px",
      "lg": "1100px",
      "xl": "1440px"
    }
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "220ms",
      "slow": "700ms",
      "pulse": "1800ms"
    },
    "easing": {
      "base": "cubic-bezier(0.2, 0.7, 0.3, 1)",
      "linear": "linear"
    },
    "reducedMotion": "respect"
  },
  "border": {
    "width": "1px",
    "widthStrong": "2px",
    "selectedRule": "2px solid #2AD5E5"
  },
  "opacity": {
    "disabled": 0.4,
    "monochromeSecondary": 0.4,
    "accentTint": 0.1,
    "gridOverlay": 0.05
  },
  "icon": {
    "family": "Lucide",
    "style": "outline",
    "strokeWidth": 1.5,
    "size": {
      "sm": "16px",
      "md": "20px",
      "lg": "24px"
    },
    "color": "currentColor"
  },
  "assets": {
    "logoSvg": null,
    "logoWordmarkFiles": null,
    "isotipoSvg": null,
    "favicon": null,
    "photographyLibrary": null,
    "notes": "No existen binarios de marca. El wordmark se compone en tipografía viva; el isotipo Beacon se construye en CSS (ver GUIA-DE-USO.md)."
  }
}