---
/**
 * Una ruta por página ready. Elige el componente de plantilla según el `template` de la página
 * y le pasa el modelo de render (src/lib/render.ts). Todo el contenido sale en el HTML de
 * servidor: cero hidratación.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Estandar from '../components/plantillas/Estandar.astro';
import Home from '../components/plantillas/Home.astro';
import Hub from '../components/plantillas/Hub.astro';
import Pais from '../components/plantillas/Pais.astro';
import type { IdPlantilla } from '../lib/plantillas.ts';
import { modeloPagina } from '../lib/render.ts';
import { cargarSitio } from '../lib/sitio.ts';

export async function getStaticPaths() {
  const entradas = await getCollection('paginas');
  return entradas.map((e) => ({
    params: { ruta: e.id === '/' ? undefined : e.id.slice(1, -1) },
    props: { id: e.id },
  }));
}

const PLANTILLA: Partial<Record<IdPlantilla, typeof Home>> = { home: Home, T3: Pais, T6: Hub };

const { id } = Astro.props;
const sitio = cargarSitio();
const p = modeloPagina(sitio, id);
const Plantilla = PLANTILLA[sitio.publicadas.get(id)!.plantilla] ?? Estandar;
---

<Base titulo={p.titulo} descripcion={p.descripcion} canonica={p.canonica}>
  <script type="application/ld+json" slot="jsonld" set:html={p.jsonld} />
  <SiteHeader slot="header" actual={id} />
  <main id="contenido">
    <Plantilla p={p} />
  </main>
  <SiteFooter slot="footer" />
</Base>
