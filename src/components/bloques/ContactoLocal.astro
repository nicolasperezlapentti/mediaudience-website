---
/**
 * B-10 · contacto local (design/referencia/bloques.html · PLANTILLAS T3).
 *
 * El contacto comercial de un mercado, distinto del institucional del footer. Datos desde
 * content/entidad.json → mercados[].contacto: solo los campos que existen, en un <dl>, sin
 * iconos. El horario lleva su zona horaria explícita. La introducción, si la hay, es el
 * Markdown de «Contacto local». Un botón secundario: el primario de la página sigue siendo
 * «Agenda una demo». Enlaces desde sitemap.json → navegacion.footerContacto.
 */
import { construirNavegacion } from '../../lib/navegacion.ts';
import { cargarSitio } from '../../lib/sitio.ts';
import type { SociedadLocal } from '../../lib/sociedades.ts';

interface Props {
  sociedad: SociedadLocal;
  introHtml?: string;
}

const { sociedad: s, introHtml = '' } = Astro.props;
const c = s.contacto!;
const contacto = construirNavegacion(cargarSitio()).contacto;
const id = `contacto-${s.codigo.toLowerCase()}`;
---

<section class="contacto" aria-labelledby={id}>
  <div class="contacto__intro">
    <p class="contacto__mercado"><span class="market-code">{s.codigo}</span>{s.pais}</p>
    <h2 class="contacto__titulo" id={id}>Contacto de {s.nombre}</h2>
    {introHtml && <div class="contacto__texto" set:html={introHtml} />}
    {
      contacto && (
        <div>
          <a class="btn btn--secundario" href={contacto.href}>Escribir al equipo de {s.nombre}</a>
        </div>
      )
    }
  </div>
  <dl class="contacto__lista">
    {
      c.oficina && (
        <div>
          <dt>Oficina</dt>
          <dd>{c.oficina}</dd>
        </div>
      )
    }
    {
      c.telefono && (
        <div>
          <dt>Teléfono</dt>
          <dd><a href={`tel:${c.telefono.replace(/\s+/g, '')}`}>{c.telefono}</a></dd>
        </div>
      )
    }
    {
      c.correo && (
        <div>
          <dt>Correo comercial</dt>
          <dd><a href={`mailto:${c.correo}`}>{c.correo}</a></dd>
        </div>
      )
    }
    {
      c.horario && (
        <div>
          <dt>Horario</dt>
          <dd>{c.horario.texto} ({c.horario.zona})</dd>
        </div>
      )
    }
  </dl>
</section>

<style>
  .contacto {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--ma-layout-card-min-width)), 1fr));
    gap: var(--ma-space-xl);
    margin: var(--ma-space-lg) 0 0;
    padding: var(--ma-space-xl);
    background: var(--ma-surface);
    border: var(--ma-border-width) solid var(--ma-border);
    border-radius: var(--ma-radius-md);
  }

  .contacto__intro {
    display: grid;
    align-content: start;
    gap: var(--ma-space-md);
  }

  .contacto__mercado {
    margin: 0;
    font-family: var(--ma-font-mono);
    font-size: var(--ma-caption-size);
    letter-spacing: var(--ma-caption-letter-spacing);
    text-transform: uppercase;
    color: var(--ma-text-muted);
  }

  .contacto__titulo {
    margin: 0;
    font-family: var(--ma-font-display);
    font-size: var(--ma-h3-size);
    font-weight: var(--ma-h3-weight);
    line-height: var(--ma-h3-line-height);
    letter-spacing: var(--ma-h3-letter-spacing);
  }

  .contacto__texto {
    max-width: var(--ma-layout-max-width-prose);
    font-size: var(--ma-small-size);
    color: var(--ma-text-muted);
  }

  .contacto__texto :global(p) {
    margin: 0;
  }

  .contacto__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--ma-layout-sidebar-width)), 1fr));
    gap: var(--ma-space-lg) var(--ma-space-xl);
    margin: 0;
  }

  dt {
    margin-bottom: var(--ma-space-xs);
    font-family: var(--ma-font-mono);
    font-size: var(--ma-label-size);
    letter-spacing: var(--ma-label-letter-spacing);
    text-transform: uppercase;
    color: var(--ma-text-muted);
  }

  dd {
    margin: 0;
    font-size: var(--ma-small-size);
    color: var(--ma-text);
  }

  @media (width < 640px) {
    .btn {
      justify-content: center;
      width: 100%;
      height: var(--ma-form-min-height);
    }
  }
</style>
