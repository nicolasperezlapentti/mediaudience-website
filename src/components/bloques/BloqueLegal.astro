---
/**
 * B-04 · Bloque legal (design/referencia/bloques.html · fact-book §1.3, «un bloque de datos
 * legales al pie de la página país»).
 *
 * Al pie de la página país, antes del footer. Se lee como un registro: un <dl> en una línea
 * separada por hairlines, sin fondo ni card. Datos desde content/entidad.json: razón social,
 * identificación fiscal (solo si existe), domicilio, fecha de constitución y actividad CIIU.
 * Es el único lugar de la página donde aparece la razón social (fact-book §1.1).
 * La grilla es intrínseca: pasa de varias columnas a una sin media query.
 */
import { formatoFechaLarga } from '../../lib/formato.ts';
import type { SociedadLocal } from '../../lib/sociedades.ts';

interface Props {
  sociedad: SociedadLocal;
}

const { sociedad: s } = Astro.props;
const id = `legal-${s.codigo.toLowerCase()}`;
---

<section class="legal" aria-labelledby={id}>
  <h2 class="legal__titulo" id={id}>Información legal · {s.nombre}</h2>
  <dl class="legal__lista">
    <div class="legal__item">
      <dt>Razón social</dt>
      <dd>{s.legalName}</dd>
    </div>
    {
      s.identificacionFiscal && (
        <div class="legal__item">
          <dt>Identificación fiscal · {s.identificacionFiscal.tipo}</dt>
          <dd>{s.identificacionFiscal.valor}</dd>
        </div>
      )
    }
    <div class="legal__item">
      <dt>Domicilio</dt>
      <dd>{s.domicilio}</dd>
    </div>
    <div class="legal__item">
      <dt>Fecha de constitución</dt>
      <dd><time datetime={s.foundingDate}>{formatoFechaLarga(s.foundingDate)}</time></dd>
    </div>
    {
      s.ciiu && (
        <div class="legal__item">
          <dt>Actividad · CIIU</dt>
          <dd>{s.ciiu}</dd>
        </div>
      )
    }
  </dl>
</section>

<style>
  .legal {
    margin: var(--ma-space-2xl) 0 var(--ma-space-3xl);
    padding: var(--ma-space-xl) 0 0;
    overflow: hidden;
    border-top: var(--ma-border-width) solid var(--ma-border);
  }

  .legal__titulo {
    margin: 0 0 var(--ma-space-md);
    font-family: var(--ma-font-mono);
    font-size: var(--ma-caption-size);
    font-weight: var(--ma-weight-regular);
    letter-spacing: var(--ma-caption-letter-spacing);
    text-transform: uppercase;
    color: var(--ma-text-muted);
  }

  /*
   * Grilla intrínseca, sin media query. La lista se corre a la izquierda lo que mide el
   * separador y .legal recorta: el primer ítem de cada fila queda alineado y sin hairline,
   * tenga la grilla cuatro columnas, dos o una.
   */
  .legal__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--ma-layout-sidebar-width), 1fr));
    gap: var(--ma-space-md) 0;
    margin: 0 0 0 calc(-1 * (var(--ma-space-lg) + var(--ma-border-width)));
  }

  .legal__item {
    padding: 0 var(--ma-space-lg);
    border-left: var(--ma-border-width) solid var(--ma-border-subtle);
  }

  dt {
    margin: 0 0 var(--ma-space-xs);
    font-family: var(--ma-font-mono);
    font-size: var(--ma-label-size);
    letter-spacing: var(--ma-label-letter-spacing);
    text-transform: uppercase;
    color: var(--ma-text-muted);
  }

  dd {
    margin: 0;
    font-size: var(--ma-small-size);
    line-height: var(--ma-small-line-height);
    color: var(--ma-text);
  }
</style>
